# Deployer private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# RPC URLs (Alchemy recommended — get key at https://dashboard.alchemy.com/)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Polygon Amoy RPC URL
AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Etherscan API key for contract verification (Sepolia/Mainnet)
ETHERSCAN_API_KEY=your_etherscan_api_key

# Polygonscan API key for contract verification (Amoy/Polygon)
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# Alchemy API key (used by all services)
ALCHEMY_API_KEY=your_alchemy_api_key
