# =============================================================================
# IRSB Agents Configuration
# Copy to .env and customize
# =============================================================================

# --- Mode Selection ---
# local  = Ollama only, zero cloud
# cloud  = Cloud LLMs only
# hybrid = Local retrieval + cloud generation (recommended)
NEXUS_MODE=local

# --- Provider Selection ---
# LLM: ollama | anthropic | vertex
NEXUS_LLM_PROVIDER=ollama
# Embeddings: ollama (always local for retrieval)
NEXUS_EMBED_PROVIDER=ollama

# --- Ollama (local-first default) ---
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# --- Anthropic (optional, for hybrid/cloud mode) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Vertex AI (optional, for hybrid/cloud mode) ---
# GOOGLE_CLOUD_PROJECT=irsb-protocol
# GOOGLE_CLOUD_REGION=us-central1
# VERTEX_MODEL=gemini-2.0-flash

# --- Ethereum RPC ---
SEPOLIA_RPC_URL=https://rpc.sepolia.org
# Or use Alchemy/Infura:
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# --- Document Processing ---
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# --- Vector Store ---
CHROMA_DB_PATH=./chroma_db
LEDGER_DB_PATH=./irsb_ledger.db

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Safety ---
HYBRID_SAFE_MODE=true
MAX_SNIPPET_LENGTH=4000

# --- Corpus Repos (auto-cloned during ingestion) ---
CORPUS_DIR=./corpus_repos
