# =============================================================================
# IRSB Agent Passkey Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
HOST="0.0.0.0"
LOG_LEVEL="info"
PORT="8080"

# -----------------------------------------------------------------------------
# Lit Protocol (threshold signatures)
# DEPRECATION: Datil networks sunset Feb 25, 2026. Plan migration to V1.
# -----------------------------------------------------------------------------

# Network: naga-dev (development), naga-test (staging), naga (production)
# Datil networks deprecated Feb 25, 2026
LIT_NETWORK="naga-dev"

# Controller wallet private key (SENSITIVE - use secret manager in production)
# This wallet authorizes session creation with Lit nodes
LIT_AUTH_PRIVATE_KEY="0x..."

# PKP public key (uncompressed, starts with 0x04)
# Required for signing. Omit to use service without signing capability.
LIT_PKP_PUBLIC_KEY="0x..."

# Session TTL in seconds (max: 86400 = 24 hours)
LIT_SESSION_EXPIRY="3600"

# -----------------------------------------------------------------------------
# IRSB Protocol Contracts
# -----------------------------------------------------------------------------
IRSB_CONTRACT_MAINNET="0x..."
IRSB_CONTRACT_SEPOLIA="0x..."

# -----------------------------------------------------------------------------
# Transaction Settings
# -----------------------------------------------------------------------------
DEFAULT_GAS_LIMIT="200000"
USE_EIP1559="true"

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
AUTH_AUDIENCE="irsb-agent-passkey"
AUTH_ISSUERS="https://accounts.google.com"
AUTH_SKIP="false"

# -----------------------------------------------------------------------------
# Session Capabilities
# -----------------------------------------------------------------------------
# HMAC secret for signing capability tokens (SENSITIVE)
CAPABILITY_SECRET="change-me-in-production"

# -----------------------------------------------------------------------------
# ERC-8004 Integration (optional)
# -----------------------------------------------------------------------------
ERC8004_ENABLED="false"
ERC8004_REGISTRY_ADDRESS=""
ERC8004_REGISTRY_CHAIN_ID=""
ERC8004_RPC_URL=""
ERC8004_API_ENDPOINT=""
